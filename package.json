{
  "name": "ionos-bucket-replication-tool",
  "private": true,
  "version": "1.0.0",
  "description": "Web app for managing IONOS Object Storage bucket replication",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server"
  }
}
